# Modèle de variables d'environnement. Copier en `.env` et renseigner.
# Ce fichier est le SEUL .env suivi par git : il ne doit contenir AUCUNE valeur réelle.

# ─── Application (exposées au navigateur) ───
# ⚠️ Le préfixe VITE_ signifie « inliné dans le bundle et servi en clair à tous les
# visiteurs ». Ne JAMAIS y mettre un secret (clé service_role, secret Stripe, mot de passe).
# Les quatre suivantes sont OBLIGATOIRES : `npm run build` refuse de construire si l'une
# manque (scripts/check-build-env.mjs), pour ne pas produire un bundle vert mais cassé.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ACCESS_CODE=
VITE_WEBHOOK_VOICE_INVENTORY=

# Présente historiquement mais lue nulle part dans `src/` : ne pas la configurer.
# VITE_STRIPE_PUBLISHABLE_KEY=

# ─── Serveur uniquement (jamais de préfixe VITE_) ───
# Le serveur Railway (railway-server.mjs) refuse de démarrer si l'une de ces variables
# manque, sauf mention « optionnelle ».
SUPABASE_SERVICE_ROLE_KEY=
# Repli accepté : NEXT_PUBLIC_SUPABASE_URL, sinon VITE_SUPABASE_URL est utilisée.
# NEXT_PUBLIC_SUPABASE_URL=

# URL publique de CET environnement, sans barre finale.
# Sert à construire les liens de retour Stripe et les liens d'invitation par email. En
# staging elle doit valoir l'URL de l'environnement, sinon un utilisateur en cours de
# paiement est renvoyé vers la PRODUCTION.
APP_URL=

# ─── Stripe ───
# ⚠️ Le sandbox et le live sont deux comptes DISTINCTS : produit, prix et clients y ont
# des identifiants différents. Ces quatre variables changent donc d'un environnement à
# l'autre. Les identifiants d'abonnement étaient auparavant écrits en dur dans le code,
# ce qui rendait le parcours abonnement intestable ailleurs qu'en production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRODUCT_ID=
STRIPE_SUBSCRIPTION_PRICE_ID=

# ─── Webhook des factures comptables (Make / Kevin) ───
# Comparé au header `X-Invoice-Secret` de chaque requête entrante.
INVOICE_WEBHOOK_SECRET=

# ─── Emails transactionnels (Resend) ───
RESEND_API_KEY=
# Optionnelle : expéditeur par défaut si absente (voir api/_lib/sendEmail.js).
# EMAIL_FROM=

# ─── Fourni par la plateforme ───
# Railway injecte PORT ; le serveur écoute dessus. Ne pas définir en production.
# PORT=3000

# ─── Outillage de capture authentifiée pour les agents ───
# Utilisé par `npm run dev:auth` et `npm run dev:shot` (scripts/dev-*.mjs).
# Sans préfixe VITE_ : ces valeurs ne doivent jamais partir dans le bundle.
#
# ⚠️ CE DÉPÔT EST PUBLIC. L'email ET le mot de passe du compte de test sont
# OBLIGATOIRES ici : aucun des deux n'a de valeur par défaut dans le code, pour
# qu'aucun identifiant ne soit lisible par n'importe qui.
DEV_AGENT_EMAIL=
DEV_AGENT_PASSWORD=
# Optionnels (surchargent les valeurs par défaut de scripts/dev-agent-lib.mjs) :
# DEV_AGENT_FICHE_ID=
# DEV_AGENT_BASE_URL=
